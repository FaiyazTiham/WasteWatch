# Server Configuration
PORT=5000
JWT_SECRET=replace_with_a_secure_jwt_secret_for_production

# Optional Remote MySQL Database (Aiven, PlanetScale, Railway, Supabase, TiDB)
# If omitted, WasteWatch automatically runs with its built-in high-performance persistent data engine
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Optional Frontend Configuration (For standalone client deployment)
# If deployed as unified monorepo on Vercel, leave empty (defaults to same-origin /api)
VITE_API_URL=
VITE_GOOGLE_MAPS_API_KEY=

# Required for persistent image uploads on Vercel/serverless deployments
# You can use CLOUDINARY_URL instead of the three separate variables below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
